rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Mail requests are created by the authenticated app and consumed by the
    // server-side Brevo function. Clients cannot read or edit them afterward.
    match /mail/{mailId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to.size() > 3
        && request.resource.data.to.size() < 255
        && request.resource.data.message is map;
      allow read, update, delete: if false;
    }
  }
}
